    <ItemGroup><AddressSanitizerRuntime Include="$(VCToolsInstallDir)bin\Hostx64\x64\clang_rt.asan*_dynamic-x86_64.dll"/></ItemGroup>
    <Copy SourceFiles="@(AddressSanitizerRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"/>
  </Target>
</Project>
