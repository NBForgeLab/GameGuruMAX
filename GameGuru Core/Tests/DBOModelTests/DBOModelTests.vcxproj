  <ItemGroup>
    <ClCompile Include="DBOModelTests.cpp"/>
    <ClCompile Include="..\..\Guru-WickedMAX\DBOModel.cpp"/>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets"/>
